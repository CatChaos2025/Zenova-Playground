{
  "name": "zenova-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @zenova/server dev",
    "dev:client": "pnpm --filter @zenova/client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "pnpm --filter \"@zenova/*\" build",
    "lint": "oxlint"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.1"
  }

}